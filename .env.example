## Copy this file to .env and provide real values locally. Never commit .env.

# Application signing secret (generate a long random value)
SECRET_KEY=change-me-to-a-long-random-secret

# MongoDB connection string
MONGODB_URI="mongodb+srv://username:password@cluster.example.mongodb.net/threatsentinel?retryWrites=true&w=majority"

# Optional service endpoints
TAXII_SERVER_URL=http://127.0.0.1:5002/api1/collections/91a7b528-80eb-42ed-a74d-c6fbd5a26116/objects/
TAXII_API_TOKEN=replace-with-your-token
TAXII_ADMIN_USERNAME=admin
TAXII_ADMIN_PASSWORD=replace-with-a-long-random-password
TAXII_USER_PASSWORD=replace-with-a-long-random-password
TAXII_BIND_HOST=127.0.0.1
TAXII_PORT=5002
# TAXII/STIX runtime data (ignored by Git)
TAXII_BUNDLES_DIR=./data/stix
IOC_PULL_OUTPUT_DIR=./data/iocs
MAX_TAXII_REQUEST_BYTES=5242880
AUTH_MAX_FAILURES=5
AUTH_FAILURE_WINDOW_SECONDS=300

# Central backend API (migration target)
BACKEND_BIND_HOST=127.0.0.1
BACKEND_PORT=8000
CVSS_POLL_SECONDS=20

# Generated rule reports and ZIP archives (kept local and ignored by Git)
REPORTS_OUTPUT_DIR=./data/reports
REPORT_DOWNLOAD_DIR=./data/downloads

# Bind network services to loopback unless remote access is explicitly required.
HEARTBEAT_BIND_HOST=127.0.0.1
HEARTBEAT_SERVER_URL=http://127.0.0.1:5001/api
AGENT_COMPANY_ID=alpha_corp
AGENT_HEARTBEAT_SECONDS=120
ORGANIZATION_DATABASE=organization1-infosec
ORGANIZATION_SYNC_POLL_SECONDS=15

# Local packet-capture workflow (runtime data under ignored data/)
CAPTURE_INPUT_DIR=./data/captures
PARSED_OUTPUT_DIR=./data/parsed
DETECTOR_OUTPUT_DIR=./data/detector_output
CAPTURE_POLL_SECONDS=30
# Leave blank to require --interface when starting the live capture monitor.
CAPTURE_INTERFACE=
CAPTURE_WINDOW_SECONDS=10
CAPTURE_PACKET_LIMIT=200
CAPTURE_COOLDOWN_SECONDS=5
# Detector logs are merged here before alert ingestion and IOC extraction.
DETECTOR_ALERT_LOG_PATH=./data/detector_output/alerts.log
DETECTOR_ALERT_POLL_SECONDS=5
IOC_EXTRACTION_OUTPUT=./data/iocs/latest_iocs.json
IOC_WHITELIST_FILE=./data/iocs/whitelist.json
IOC_POLL_SECONDS=30
FILE_SERVER_BIND_HOST=127.0.0.1
MAX_UPLOAD_BYTES=16777216

# Rule/report download client credentials
FILE_SERVER_URL=http://127.0.0.1:5005
FILE_SERVER_USERNAME=replace-with-your-file-server-username
FILE_SERVER_PASSWORD=replace-with-your-file-server-password
